#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        js_arrow_fn_macro: JS_ARROW_FN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp EQUAL &kp GT &kp RBKT &kp RBRC>;
            label = "JS_ARROW_FN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&none  &kp Q             &kp W               &kp E           &kp R            &kp T             &kp Y            &kp U            &kp I       &kp O                &kp P                 &none
&none  &mt LEFT_SHIFT A  &mt LEFT_CONTROL S  &mt LEFT_ALT D  &mt LEFT_GUI F   &mt LEFT_GUI G    &mt RIGHT_GUI H  &mt RIGHT_GUI J  &mt RALT K  &mt RIGHT_CONTROL L  &mt RIGHT_SHIFT SEMI  &none
&none  &kp Z             &kp X               &kp C           &kp V            &kp B             &kp N            &kp M            &kp COMMA   &kp DOT              &lt 2 FSLH            &none
                                             &lt 2 DELETE    &lt 3 BACKSPACE  &mt LGUI SPACE    &lt 6 ENTER      &lt 3 TAB        &lt 3 ESC
            >;
        };

        windows_gui_ctrl {
            bindings = <
&none   &trans  &trans          &trans  &trans       &trans             &trans       &trans       &trans  &trans      &trans  &trans
&trans  &trans  &mt LEFT_WIN S  &trans  &mt LCTRL F  &mt LCTRL G        &mt LCTRL H  &mt LCTRL J  &trans  &mt RWIN L  &trans  &trans
&trans  &trans  &trans          &trans  &trans       &trans             &trans       &trans       &trans  &trans      &trans  &trans
                                &trans  &trans       &mt LCTRL SPACE    &trans       &trans       &trans
            >;
        };

        lower_layer {
            bindings = <
&none  &kp N1      &kp N2          &kp N3          &kp N4           &kp N5    &kp N6    &kp N7          &kp N8          &kp N9           &kp N0             &none
&none  &trans      &trans          &msc SCRL_UP    &trans           &trans    &trans    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &kp C_VOL_UP       &none
&none  &kp ESCAPE  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans    &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp C_VOLUME_DOWN  &none
                                   &trans          &trans           &trans    &mkp MB1  &mkp MB2        &tog 4
            >;
        };

        symbols_layer {
            bindings = <
&none  &kp PLUS   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ASTERISK  &kp HASH     &kp PRCNT  &kp EQUAL     &kp EXCL  &kp UNDER  &kp MINUS  &none
&none  &kp AT     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOLLAR    &kp TILDE    &kp GRAVE  &kp QUESTION  &kp UP    &kp SQT    &kp PIPE   &none
&none  &kp GRAVE  &kp LBKT              &kp RBKT               &kp CARET     &kp COLON    &kp AMPS   &kp LEFT      &kp DOWN  &kp RIGHT  &kp FSLH   &none
                                        &trans                 &trans        &trans       &trans     &trans        &trans
            >;
        };

        gaming {
            bindings = <
&trans  &kp ESC           &kp Q  &kp W  &kp E    &kp R        &kp Y      &kp U    &kp I      &kp O    &kp P     &none
&trans  &kp LEFT_SHIFT    &kp A  &kp S  &kp D    &kp F        &kp H      &kp J    &kp K      &kp L    &kp SEMI  &trans
&trans  &kp LEFT_CONTROL  &kp Z  &kp X  &kp C    &kp V        &kp N      &kp M    &kp COMMA  &kp DOT  &kp FSLH  &none
                                 &mo 5  &kp TAB  &kp SPACE    &kp ENTER  &kp TAB  &tog 4
            >;
        };

        gaming_2 {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        setup_and_macros_layer {
            bindings = <
&none  &js_arrow_fn_macro  &trans  &trans  &trans  &trans    &trans        &trans          &trans        &trans        &bootloader   &none
&none  &trans              &trans  &trans  &trans  &trans    &tog 1        &bt BT_CLR_ALL  &trans        &trans        &trans        &none
&none  &trans              &trans  &trans  &trans  &trans    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
                                   &trans  &trans  &trans    &trans        &trans          &trans
            >;
        };
    };
};
