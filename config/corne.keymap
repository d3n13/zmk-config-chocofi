    combos {
        compatible = "zmk,combos";

        combo_zx_toggle_setup_layer {
            bindings = <&mo 10>;
            key-positions = <25 26>;
        };

        combo_caps_word_on_shifts {
            bindings = <&caps_word_symb_behavior>;
            key-positions = <13 22>;
        };
    };

    behaviors {
        caps_word_symb_behavior: caps_word_symb_behavior {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS_WORD_SYMB_BEHAVIOR";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE BACKSPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&none  &kp Q             &kp W               &kp E           &kp R            &kp T             &kp Y            &kp U            &kp I       &kp O                &kp P                 &none
&none  &mt LEFT_SHIFT A  &mt LEFT_CONTROL S  &mt LEFT_ALT D  &mt LEFT_GUI F   &mt LEFT_GUI G    &mt RIGHT_GUI H  &mt RIGHT_GUI J  &mt RALT K  &mt RIGHT_CONTROL L  &mt RIGHT_SHIFT SEMI  &none
&none  &kp Z             &kp X               &kp C           &kp V            &kp B             &kp N            &kp M            &kp COMMA   &kp DOT              &lt 4 FSLH            &none
                                             &lt 4 DELETE    &lt 6 BACKSPACE  &mt LGUI SPACE    &lt 9 ENTER      &lt 6 TAB        &lt 6 ESC
            >;
        };

        windows_gui_ctrl_layer {
            bindings = <
&trans  &trans  &trans          &trans  &trans       &trans             &trans       &trans       &trans  &trans      &trans  &trans
&trans  &trans  &mt LEFT_WIN S  &trans  &mt LCTRL F  &mt LCTRL G        &mt LCTRL H  &mt LCTRL J  &trans  &mt RWIN L  &trans  &trans
&trans  &trans  &trans          &trans  &trans       &trans             &trans       &trans       &trans  &trans      &trans  &trans
                                &trans  &trans       &mt LCTRL SPACE    &trans       &trans       &trans
            >;
        };

        unicode_hex_ru_lc {
            bindings = <
&trans  &unicode_ru_i_kratkaya_lc  &unicode_ru_ts_lc  &unicode_ru_u_lc  &unicode_ru_k_lc  &unicode_ru_e_lc    &unicode_ru_n_lc  &unicode_ru_g_lc             &unicode_ru_sh_lc  &unicode_ru_shch_lc  &unicode_ru_z_lc     &trans
&trans  &lt 3 LS(unicode_ru_f_lc)                &unicode_ru_y_lc   &unicode_ru_v_lc  &unicode_ru_a_lc  &unicode_ru_p_lc    &unicode_ru_r_lc  &unicode_ru_o_lc             &unicode_ru_l_lc   &unicode_ru_d_lc     &lt 3 RS(unicode_ru_zh_uc)  &trans
&trans  &unicode_ru_ya_lc          &unicode_ru_ch_lc  &unicode_ru_s_lc  &unicode_ru_m_lc  &unicode_ru_i_lc    &unicode_ru_t_lc  &unicode_ru_myagkii_znak_lc  &unicode_ru_b_lc   &unicode_ru_yu_lc    &trans               &trans
                                                      &trans            &trans            &trans              &trans            &trans
            >;
        };

        unicode_hex_ru_uc {
            bindings = <
&trans  &unicode_ru_i_kratkaya_uc  &unicode_ru_ts_uc  &unicode_ru_u_uc  &unicode_ru_k_uc  &unicode_ru_e_uc    &unicode_ru_n_uc  &unicode_ru_g_uc             &unicode_ru_sh_uc  &unicode_ru_shch_uc  &unicode_ru_z_uc   &trans
&trans  &unicode_ru_f_uc           &unicode_ru_y_uc   &unicode_ru_v_uc  &unicode_ru_a_uc  &unicode_ru_p_uc    &unicode_ru_r_uc  &unicode_ru_o_uc             &unicode_ru_l_uc   &unicode_ru_d_uc     &unicode_ru_zh_uc  &trans
&trans  &unicode_ru_ya_uc          &unicode_ru_ch_uc  &unicode_ru_s_uc  &unicode_ru_m_uc  &unicode_ru_i_uc    &unicode_ru_t_uc  &unicode_ru_myagkii_znak_uc  &unicode_ru_b_uc   &unicode_ru_yu_uc    &trans             &trans
                                                      &trans            &trans            &trans              &trans            &trans
            >;
        };

        nums_mouse_misc_layer {
            bindings = <
&trans  &kp N1      &kp N2          &kp N3          &kp N4           &kp N5    &kp N6    &kp N7          &kp N8          &kp N9           &kp N0             &trans
&trans  &trans      &trans          &msc SCRL_UP    &trans           &trans    &trans    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &kp C_VOL_UP       &trans
&trans  &kp ESCAPE  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans    &mo 5     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp C_VOLUME_DOWN  &trans
                                    &trans          &trans           &trans    &mkp MB1  &mkp MB2        &tog 7
            >;
        };

        one_handed_mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &msc SCRL_UP    &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_LEFT  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans          &trans
            >;
        };

        symbols_arrows_layer {
            bindings = <
&trans  &kp PLUS   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ASTERISK  &kp HASH     &kp PRCNT  &kp EQUAL     &kp EXCL  &kp UNDER  &kp MINUS  &trans
&trans  &kp AT     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOLLAR    &kp TILDE    &kp GRAVE  &kp QUESTION  &kp UP    &kp SQT    &kp PIPE   &trans
&trans  &kp GRAVE  &kp LBKT              &kp RBKT               &kp CARET     &kp COLON    &kp AMPS   &kp LEFT      &kp DOWN  &kp RIGHT  &kp BSLH   &trans
                                         &trans                 &trans        &trans       &trans     &trans        &trans
            >;
        };

        gaming_layer {
            bindings = <
&trans  &kp ESC           &kp Q  &kp W  &kp E    &kp R        &kp Y      &kp U    &kp I      &kp O    &kp P     &trans
&trans  &kp LEFT_SHIFT    &kp A  &kp S  &kp D    &kp F        &kp H      &kp J    &kp K      &kp L    &kp SEMI  &trans
&trans  &kp LEFT_CONTROL  &kp Z  &kp X  &kp C    &kp V        &kp N      &kp M    &kp COMMA  &kp DOT  &kp FSLH  &trans
                                 &mo 8  &kp TAB  &kp SPACE    &kp ENTER  &kp TAB  &tog 7
            >;
        };

        gaming_2_layer {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        setup_and_macros_layer {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &trans        &soft_off       &ext_power EP_ON   &sys_reset    &bootloader   &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &tog 1        &bt BT_CLR_ALL  &ext_power EP_OFF  &out OUT_BLE  &out OUT_USB  &trans
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4  &trans
                          &trans   &trans   &trans     &trans        &trans          &trans
            >;
        };

        setup_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &bootloader    &trans  &trans  &trans  &trans  &trans                &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_INC  &trans
&trans  &trans  &trans  &tog 2  &tog 1  &trans         &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_DEC  &trans
                        &trans  &trans  &trans         &trans  &trans  &trans
            >;
        };
    };
};
