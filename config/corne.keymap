        unicode_test: unicode_test {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
            label = "UNICODE_TEST";
        };

        js_arrow_fn_macro: js_arrow_fn_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LPAR &kp RPAR &kp EQUAL &kp GT &kp LBRC &kp RBRC &kp LEFT>,
                <&macro_release>;

            label = "JS_ARROW_FN_MACRO";
        };

        js_fn_macro: js_fn_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp F &kp U &kp N &kp C &kp T &kp I &kp O &kp N &kp SPACE &kp LPAR &kp RPAR &kp LBRC &kp RBRC &kp LEFT>,
                <&macro_release>;

            label = "JS_FN_MACRO";
        };

        js_promise_macro: js_promise_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp N &kp E &kp W &kp SPACE &kp LS(P) &kp R &kp O &kp M &kp I &kp S &kp E &kp LPAR &kp LPAR &kp R &kp E &kp S &kp COMMA &kp R &kp E &kp J &kp RPAR &kp EQUAL &kp GT &kp R &kp E &kp S &kp LPAR &kp RPAR &kp LEFT_BRACE &kp RBRC &kp RPAR &kp LEFT_ARROW &kp LEFT_ARROW &kp LEFT>,
                <&macro_release>;

            label = "JS_PROMISE_MACRO";
        };

        jsx_useEffect_macro: jsx_useEffect_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp U &kp S &kp E &kp LS(E) &kp F &kp F &kp E &kp C &kp T &kp LPAR &kp LPAR &kp RPAR &kp EQUAL &kp GT &kp LBRC &kp RBRC &kp COMMA &kp LBKT &kp RIGHT_BRACKET &kp RPAR &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT>,
                <&macro_release>;

            label = "JSX_USEEFFECT_MACRO";
        };

        jsx_useState_macro: jsx_useState_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp C &kp O &kp N &kp S &kp T &kp SPACE &kp LBKT &kp S &kp T &kp A &kp T &kp E &kp COMMA &kp S &kp E &kp T &kp LS(S) &kp T &kp A &kp T &kp E &kp RBKT &kp EQUAL &kp U &kp S &kp E &kp LS(S) &kp T &kp A &kp T &kp E &kp LPAR &kp RPAR &kp LEFT>,
                <&macro_release>;

            label = "JSX_USESTATE_MACRO";
        };

        jsx_useRef_macro: jsx_useRef_macro {
