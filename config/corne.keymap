          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <5>;
          tap-ms = <5>;
          bindings =
              <&macro_press>,
              <&kp LALT>,
              <&macro_tap>,
              <&kp KP_N0 &kp KP_N4 &kp KP_N3 &kp KP_N9>,
              <&macro_release>,
